# WikiStock AI Service - cấu hình chạy trực tiếp trên máy host
# Sao chép thành ai-service/.env và không commit secret thật.

SEED_DATA_PATH=../runtime/ocr/output
MAX_PDF_SIZE_MB=100
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200
CHUNK_VERSION=v1-page-block-1800-200
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35
HF_HOME=../runtime/model-cache

# demo không gọi database/provider; gateway chạy RAG với provider thật.
AI_PROVIDER=demo
AI_API_BASE_URL=https://claude.zunef.com/v1/ai
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_CUSTOM_HEADERS=
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=45

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Chỉ dùng cho test tích hợp; phải trỏ tới database có thể xóa dữ liệu test.
TEST_DATABASE_URL=
