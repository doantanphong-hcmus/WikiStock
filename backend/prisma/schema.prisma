generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// NHÓM 1: LOOKUP / DANH MỤC
// =============================================================

model Exchange {
  exchangeId   Int    @id @default(autoincrement()) @map("exchange_id")
  exchangeCode String @unique @map("exchange_code") @db.VarChar(10)
  exchangeName String @map("exchange_name") @db.VarChar(100)

  companies Company[]

  @@map("exchange")
}

model Industry {
  industryId   Int    @id @default(autoincrement()) @map("industry_id")
  industryCode String @unique @map("industry_code") @db.VarChar(20)
  industryName String @map("industry_name") @db.VarChar(150)

  companies Company[]

  @@map("industry")
}

model DataSource {
  sourceId        Int     @id @default(autoincrement()) @map("source_id")
  sourceName      String  @unique @map("source_name") @db.VarChar(100)
  sourceType      String  @map("source_type") @db.VarChar(30)
  reliabilityTier Int     @map("reliability_tier") @db.SmallInt
  costTier        String  @map("cost_tier") @db.VarChar(20)
  accessUrl       String? @map("access_url") @db.Text

  sourceDocuments   SourceDocument[]
  newsArticles      NewsArticle[]
  dataIngestionLogs DataIngestionLog[]

  @@map("data_source")
}

model DocumentType {
  docTypeId Int    @id @default(autoincrement()) @map("doc_type_id")
  typeName  String @unique @map("type_name") @db.VarChar(100)

  sourceDocuments SourceDocument[]

  @@map("document_type")
}

model Metric {
  metricId      Int    @id @default(autoincrement()) @map("metric_id")
  metricCode    String @unique @map("metric_code") @db.VarChar(30)
  metricName    String @map("metric_name") @db.VarChar(150)
  unit          String @db.VarChar(20)
  statementType String @map("statement_type") @db.VarChar(30)

  financialLineItems FinancialLineItem[]

  @@map("metric")
}

model EventType {
  eventTypeId Int    @id @default(autoincrement()) @map("event_type_id")
  typeName    String @unique @map("type_name") @db.VarChar(100)

  timelineEvents TimelineEvent[]

  @@map("event_type")
}

model RiskSignalType {
  signalTypeId  Int     @id @default(autoincrement()) @map("signal_type_id")
  signalName    String  @unique @map("signal_name") @db.VarChar(100)
  description   String? @db.Text
  defaultWeight Decimal @default(1.0) @map("default_weight") @db.Decimal(4, 2)

  riskSignals RiskSignal[]

  @@map("risk_signal_type")
}

model UserRole {
  roleId   Int    @id @default(autoincrement()) @map("role_id")
  roleName String @unique @map("role_name") @db.VarChar(30)

  users AppUser[]

  @@map("user_role")
}

// =============================================================
// NHÓM 2: COMPANY KNOWLEDGE
// =============================================================

model Company {
  companyId      Int       @id @default(autoincrement()) @map("company_id")
  ticker         String    @unique @db.VarChar(10)
  companyName    String    @map("company_name") @db.VarChar(255)
  exchangeId     Int       @map("exchange_id")
  industryId     Int       @map("industry_id")
  listingDate    DateTime? @map("listing_date") @db.Date
  charterCapital Decimal?  @map("charter_capital") @db.Decimal(20, 2)
  website        String?   @db.Text
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  exchange Exchange @relation(fields: [exchangeId], references: [exchangeId])
  industry Industry @relation(fields: [industryId], references: [industryId])

  sourceDocuments         SourceDocument[]
  executives              CompanyExecutive[]
  financialReports        FinancialReport[]
  newsArticleCompanies    NewsArticleCompany[]
  timelineEvents          TimelineEvent[]
  riskSignals             RiskSignal[]
  riskScores              RiskScore[]
  aiMessages              AiMessage[]
  watchlists              Watchlist[]
  compareSessionCompanies CompareSessionCompany[]

  @@map("company")
}

// =============================================================
// NHÓM 3: NGUỒN TÀI LIỆU & CITATION ENGINE
// =============================================================

model SourceDocument {
  documentId      Int       @id @default(autoincrement()) @map("document_id")
  companyId       Int?      @map("company_id")
  sourceId        Int       @map("source_id")
  docTypeId       Int       @map("doc_type_id")
  title           String    @db.VarChar(500)
  publishedDate   DateTime? @map("published_date") @db.Date
  fiscalYear      Int?      @map("fiscal_year") @db.SmallInt
  fiscalQuarter   Int?      @map("fiscal_quarter") @db.SmallInt
  url             String?   @db.Text
  fileRef         String?   @map("file_ref") @db.Text
  crawledAt       DateTime  @default(now()) @map("crawled_at") @db.Timestamptz(6)
  checksum        String?   @unique @db.VarChar(64)
  ingestionStatus String    @default("pending") @map("ingestion_status") @db.VarChar(20)
  ingestedAt      DateTime? @map("ingested_at") @db.Timestamptz(6)
  ingestionError  String?   @map("ingestion_error") @db.Text
  embeddingModel  String?   @map("embedding_model") @db.VarChar(100)
  chunkVersion    String?   @map("chunk_version") @db.VarChar(30)

  company      Company?     @relation(fields: [companyId], references: [companyId])
  source       DataSource   @relation(fields: [sourceId], references: [sourceId])
  documentType DocumentType @relation(fields: [docTypeId], references: [docTypeId])

  executives       CompanyExecutive[]
  citations        Citation[]
  chunks           DocumentChunk[]
  financialReports FinancialReport[]
  documentReview   DocumentReview?

  @@index([companyId], map: "idx_source_document_company")
  @@map("source_document")
}

model DocumentChunk {
  chunkId     Int       @id @default(autoincrement()) @map("chunk_id")
  documentId  Int       @map("document_id")
  chunkIndex  Int       @map("chunk_index")
  pageNumber  Int       @map("page_number")
  locationRef String    @map("location_ref") @db.VarChar(100)
  content     String    @db.Text
  charCount   Int       @map("char_count")
  contentHash String    @map("content_hash") @db.VarChar(64)
  // Prisma keeps the column in schema history; ai-service reads/writes it with raw SQL.
  embedding   Unsupported("vector")?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document SourceDocument @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  citation Citation?

  @@unique([documentId, chunkIndex])
  @@map("document_chunk")
}

model CompanyExecutive {
  executiveId Int       @id @default(autoincrement()) @map("executive_id")
  companyId   Int       @map("company_id")
  fullName    String    @map("full_name") @db.VarChar(150)
  position    String    @db.VarChar(150)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  documentId  Int?      @map("document_id")

  company  Company         @relation(fields: [companyId], references: [companyId])
  document SourceDocument? @relation(fields: [documentId], references: [documentId])

  @@map("company_executive")
}

model Citation {
  citationId  Int      @id @default(autoincrement()) @map("citation_id")
  documentId  Int      @map("document_id")
  chunkId     Int?     @unique @map("chunk_id")
  excerpt     String?  @db.Text
  locationRef String?  @map("location_ref") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document SourceDocument @relation(fields: [documentId], references: [documentId])
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [chunkId], onDelete: SetNull)

  financialLineItemCitations FinancialLineItemCitation[]
  timelineEventCitations     TimelineEventCitation[]
  riskSignalCitations        RiskSignalCitation[]
  aiMessageCitations         AiMessageCitation[]

  @@map("citation")
}

// =============================================================
// NHÓM 4: FINANCIAL CENTER
// =============================================================

model FinancialReport {
  reportId      Int       @id @default(autoincrement()) @map("report_id")
  companyId     Int       @map("company_id")
  periodType    String    @map("period_type") @db.VarChar(1)
  fiscalYear    Int       @map("fiscal_year") @db.SmallInt
  fiscalQuarter Int?      @map("fiscal_quarter") @db.SmallInt
  reportDate    DateTime? @map("report_date") @db.Date
  documentId    Int?      @map("document_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company         @relation(fields: [companyId], references: [companyId])
  document SourceDocument? @relation(fields: [documentId], references: [documentId])

  lineItems FinancialLineItem[]

  @@unique([companyId, periodType, fiscalYear, fiscalQuarter])
  @@index([companyId], map: "idx_financial_report_company")
  @@map("financial_report")
}

model FinancialLineItem {
  lineItemId Int      @id @default(autoincrement()) @map("line_item_id")
  reportId   Int      @map("report_id")
  metricId   Int      @map("metric_id")
  value      Decimal  @db.Decimal(20, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report FinancialReport @relation(fields: [reportId], references: [reportId])
  metric Metric          @relation(fields: [metricId], references: [metricId])

  citations FinancialLineItemCitation[]

  @@unique([reportId, metricId])
  @@map("financial_line_item")
}

model FinancialLineItemCitation {
  lineItemId Int @map("line_item_id")
  citationId Int @map("citation_id")

  lineItem FinancialLineItem @relation(fields: [lineItemId], references: [lineItemId])
  citation Citation          @relation(fields: [citationId], references: [citationId])

  @@id([lineItemId, citationId])
  @@map("financial_line_item_citation")
}

// =============================================================
// NHÓM 5: NEWS INTELLIGENCE
// =============================================================

model NewsArticle {
  articleId      Int       @id @default(autoincrement()) @map("article_id")
  sourceId       Int       @map("source_id")
  title          String    @db.VarChar(500)
  url            String    @unique @db.Text
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  summary        String?   @db.Text
  sentimentLabel String?   @map("sentiment_label") @db.VarChar(20)
  crawledAt      DateTime  @default(now()) @map("crawled_at") @db.Timestamptz(6)

  source DataSource @relation(fields: [sourceId], references: [sourceId])

  companies NewsArticleCompany[]

  @@index([publishedAt], map: "idx_news_article_published")
  @@map("news_article")
}

model NewsArticleCompany {
  articleId      Int      @map("article_id")
  companyId      Int      @map("company_id")
  relevanceScore Decimal? @map("relevance_score") @db.Decimal(3, 2)

  article NewsArticle @relation(fields: [articleId], references: [articleId])
  company Company     @relation(fields: [companyId], references: [companyId])

  @@id([articleId, companyId])
  @@map("news_article_company")
}

// =============================================================
// NHÓM 6: TIMELINE
// =============================================================

model TimelineEvent {
  eventId     Int      @id @default(autoincrement()) @map("event_id")
  companyId   Int      @map("company_id")
  eventTypeId Int      @map("event_type_id")
  eventDate   DateTime @map("event_date") @db.Date
  title       String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [companyId])
  eventType EventType @relation(fields: [eventTypeId], references: [eventTypeId])

  citations TimelineEventCitation[]

  @@index([companyId, eventDate], map: "idx_timeline_event_company")
  @@map("timeline_event")
}

model TimelineEventCitation {
  eventId    Int @map("event_id")
  citationId Int @map("citation_id")

  event    TimelineEvent @relation(fields: [eventId], references: [eventId])
  citation Citation      @relation(fields: [citationId], references: [citationId])

  @@id([eventId, citationId])
  @@map("timeline_event_citation")
}

// =============================================================
// NHÓM 7: RISK CENTER
// =============================================================

model RiskSignal {
  signalId     Int      @id @default(autoincrement()) @map("signal_id")
  companyId    Int      @map("company_id")
  signalTypeId Int      @map("signal_type_id")
  period       String   @db.VarChar(10)
  value        Decimal? @db.Decimal(20, 4)
  detectedAt   DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)

  company    Company        @relation(fields: [companyId], references: [companyId])
  signalType RiskSignalType @relation(fields: [signalTypeId], references: [signalTypeId])

  citations RiskSignalCitation[]

  @@unique([companyId, signalTypeId, period])
  @@index([companyId, period], map: "idx_risk_signal_company")
  @@map("risk_signal")
}

model RiskSignalCitation {
  signalId   Int @map("signal_id")
  citationId Int @map("citation_id")

  signal   RiskSignal @relation(fields: [signalId], references: [signalId])
  citation Citation   @relation(fields: [citationId], references: [citationId])

  @@id([signalId, citationId])
  @@map("risk_signal_citation")
}

model RiskScore {
  scoreId    Int      @id @default(autoincrement()) @map("score_id")
  companyId  Int      @map("company_id")
  period     String   @db.VarChar(10)
  totalScore Decimal  @map("total_score") @db.Decimal(5, 2)
  riskLevel  String   @map("risk_level") @db.VarChar(20)
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [companyId])

  @@unique([companyId, period])
  @@map("risk_score")
}

// =============================================================
// NHÓM 8: USERS / AI ANALYST
// =============================================================

model AppUser {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  fullName     String?  @map("full_name") @db.VarChar(150)
  roleId       Int      @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role UserRole @relation(fields: [roleId], references: [roleId])

  conversations   AiConversation[]
  watchlists      Watchlist[]
  compareSessions CompareSession[]
  documentReviews DocumentReview[]

  @@map("app_user")
}

model AiConversation {
  conversationId Int      @id @default(autoincrement()) @map("conversation_id")
  userId         Int?     @map("user_id")
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [userId], references: [userId])

  messages AiMessage[]

  @@map("ai_conversation")
}

model AiMessage {
  messageId        Int      @id @default(autoincrement()) @map("message_id")
  conversationId   Int      @map("conversation_id")
  role             String   @db.VarChar(10)
  content          String   @db.Text
  relatedCompanyId Int?     @map("related_company_id")
  modelUsed        String?  @map("model_used") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   AiConversation @relation(fields: [conversationId], references: [conversationId])
  relatedCompany Company?       @relation(fields: [relatedCompanyId], references: [companyId])

  citations AiMessageCitation[]

  @@index([conversationId], map: "idx_ai_message_conversation")
  @@map("ai_message")
}

model AiMessageCitation {
  messageId  Int @map("message_id")
  citationId Int @map("citation_id")

  message  AiMessage @relation(fields: [messageId], references: [messageId])
  citation Citation  @relation(fields: [citationId], references: [citationId])

  @@id([messageId, citationId])
  @@map("ai_message_citation")
}

// =============================================================
// NHÓM 9: COMPARE & WATCHLIST
// =============================================================

model Watchlist {
  watchlistId Int      @id @default(autoincrement()) @map("watchlist_id")
  userId      Int      @map("user_id")
  companyId   Int      @map("company_id")
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  user    AppUser @relation(fields: [userId], references: [userId])
  company Company @relation(fields: [companyId], references: [companyId])

  @@unique([userId, companyId])
  @@map("watchlist")
}

model CompareSession {
  sessionId Int      @id @default(autoincrement()) @map("session_id")
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [userId], references: [userId])

  companies CompareSessionCompany[]

  @@map("compare_session")
}

model CompareSessionCompany {
  sessionId Int @map("session_id")
  companyId Int @map("company_id")

  session CompareSession @relation(fields: [sessionId], references: [sessionId])
  company Company        @relation(fields: [companyId], references: [companyId])

  @@id([sessionId, companyId])
  @@map("compare_session_company")
}

// =============================================================
// NHÓM 10: ADMIN / CMS / VẬN HÀNH DỮ LIỆU
// =============================================================

model DataIngestionLog {
  logId          Int      @id @default(autoincrement()) @map("log_id")
  sourceId       Int      @map("source_id")
  runAt          DateTime @default(now()) @map("run_at") @db.Timestamptz(6)
  status         String   @db.VarChar(20)
  recordsFetched Int?     @default(0) @map("records_fetched")
  errorMessage   String?  @map("error_message") @db.Text

  source DataSource @relation(fields: [sourceId], references: [sourceId])

  @@map("data_ingestion_log")
}

model DocumentReview {
  documentId   Int       @id @map("document_id")
  reviewedBy   Int?      @map("reviewed_by")
  reviewStatus String    @default("pending") @map("review_status") @db.VarChar(20)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  notes        String?   @db.Text

  document SourceDocument @relation(fields: [documentId], references: [documentId])
  reviewer AppUser?       @relation(fields: [reviewedBy], references: [userId])

  @@map("document_review")
}
