# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Local PostgreSQL via Docker Compose (default)
DATABASE_URL=postgresql://wikistock:wikistock@localhost:5432/wikistock

# Supabase PostgreSQL (optional)
# Thay DATABASE_URL phía trên bằng giá trị này khi dùng Supabase.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<YOUR_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Auth
JWT_SECRET=replace_with_a_long_random_local_dev_secret