# WikiStock Environment Variables
# Copy this file to .env and fill in the values

# JWT Secret (required)
JWT_SECRET=wikistock-dev-secret-key-2026

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
DATABASE_URL=postgresql://app_user:app_password@postgres:5432/app_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=60000
AI_DEMO_MODE=false
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35

# Frontend
FRONTEND_URL=http://localhost:3000
