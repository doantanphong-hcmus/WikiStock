# WikiStock - cấu hình mẫu cho Docker Compose
# Sao chép thành .env; không commit file .env hoặc secret thật.

# Backend
JWT_SECRET=replace_with_at_least_32_random_characters
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=60000
AI_DEMO_MODE=false

# PostgreSQL trong Docker Compose
DB_HOST=postgres
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
DATABASE_URL=postgresql://app_user:app_password@postgres:5432/app_db

# PDF trên máy host được mount read-only vào Backend và AI Service.
# Dùng output OCR để ingest đủ 12 PDF; xem docs/RAG_OPERATIONS_RUNBOOK.md.
RAG_SEED_DATA_PATH=./runtime/ocr/output
SEED_DATA_PATH=/data/seed_data

# Chia đoạn, embedding và retrieval
MAX_PDF_SIZE_MB=100
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200
CHUNK_VERSION=v1-page-block-1800-200
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35
HF_HOME=/models

# demo không gọi database/provider; gateway chạy RAG với provider thật.
AI_PROVIDER=demo
AI_API_BASE_URL=https://claude.zunef.com/v1/ai
AI_API_KEY=
AI_AUTH_SCHEME=bearer
AI_MODEL=claude-sonnet-4-6
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=45
AI_CUSTOM_HEADERS=

# Frontend: trình duyệt gọi cổng host, server-side rendering gọi service nội bộ.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
API_BASE_URL=http://backend:3001/api/v1
