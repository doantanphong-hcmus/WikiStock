# ==========================================
# WIKISTOCK - GLOBAL ENVIRONMENT VARIABLES
# Lưu ý: Copy file này thành `.env` để sử dụng cho việc test local
# ==========================================

# 1. DATABASE (PostgreSQL + pgvector)
# Thông tin này sẽ được Docker Compose và Prisma sử dụng chung
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# 2. REDIS CACHE
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. BACKEND (NestJS)
NODE_ENV=development
BACKEND_PORT=8080
JWT_SECRET=super_secret_jwt_key_for_development

# 4. FRONTEND (Next.js)
FRONTEND_PORT=3000
# Để Next.js gọi được API Backend từ client-side
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# 5. AI SERVICE (FastAPI) & LLM KEYS
AI_SERVICE_URL=http://localhost:8000

# API Keys cho mô hình AI (Phong sẽ cần cái này để chạy RAG)
OPENAI_API_KEY=sk-your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
